# ==========================================================================
# NetGraph Environment Configuration Template
# Copy this file to '.env' and edit the variables for your local setup.
# ==========================================================================

# ----------------------------------------------------
# 1. Database Connection URL
# ----------------------------------------------------
# LOCAL DOCKER: Point to the 'netgraph-db' service running in docker-compose
DATABASE_URL=postgresql://netgraph:netgraph_password@localhost:5432/netgraph

# OFFLINE FALLBACK: Uncomment below to run standalone on a local SQLite file (no Docker required!)
# DATABASE_URL=sqlite:///netgraph.db

# CLOUD HYBRID: Swap to your serverless PostgreSQL link (e.g., Neon) to enable cloud synchronization
# DATABASE_URL=postgresql://user:password@ep-cool-breeze-123456.us-east-2.aws.neon.tech/netgraph?sslmode=require

# ----------------------------------------------------
# 2. Local Zep Memory Server
# ----------------------------------------------------
# Local Zep Community Edition endpoint spun up by docker-compose
ZEP_API_URL=http://localhost:8000

# ----------------------------------------------------
# 3. Authentication Secrets
# ----------------------------------------------------
# Secure random string used to sign JWT session tokens. Change this in production!
JWT_SECRET=supersecretjwtsecretkeyshouldbechangeinproduction1029384756
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------
# 4. Optional Cloud LLM API Keys
# ----------------------------------------------------
# Leave these blank to use NetGraph's 100% offline local Graph & NLP reasoning engine.
# Provide a key below to automatically route chat queries to advanced cloud LLMs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
